# Copy only as local configuration; the server does not auto-load dotenv files.
# `pnpm setup:local` generates private local files; no values belong in Git.
GUARD_CONFIG_FILE=./artifacts/local/config.json
SOURCE_MODE=fixture
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_PATH=./artifacts/local/guard.sqlite
# Optional programmatic live-provider configuration, not used by standalone server:
RPC_URL=
INDEXER_BASE_URL=
INDEXER_API_KEY=
# Owner/recovery credentials belong to a separate CLI/wallet process.
