{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@counterparty-guard/shared": [
        "packages/shared/src/index.ts"
      ],
      "@counterparty-guard/providers": [
        "packages/providers/src/index.ts"
      ],
      "@counterparty-guard/scoring": [
        "packages/scoring/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/providers/**/*.ts",
    "packages/scoring/**/*.ts",
    "scripts/person-a/**/*.ts",
    "tests/integration/**/*.ts",
    "vitest*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts"
  ]
}
