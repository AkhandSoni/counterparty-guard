{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./",
    "outDir": "./dist-ts",
    "tsBuildInfoFile": "./dist-ts/.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@counterparty-guard/shared": ["../../packages/shared/dist/src/index.d.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
